# Database
DATABASE_URL="file:./dev.db"

# Polymarket Providers
MARKET_PROVIDER="polymarket_rest"
POLYMARKET_GAMMA_BASE_URL="https://gamma-api.polymarket.com"
POLYMARKET_CLOB_BASE_URL="https://clob.polymarket.com"

# RSSHub configurations
RSSHUB_BASE_URL="http://orangepi:1200"

# FinBERT Sentiment Service
FINBERT_API_URL="https://3kmfi6hp-finbert-sentiment-api.hf.space/predict"
FINBERT_TIMEOUT_MS="20000"

# Cron secret & batch limits
CRON_SECRET="replace-with-random-secret"
REFRESH_MARKETS_LIMIT="100"
REFRESH_NEWS_MARKETS_LIMIT="20"
REFRESH_NEWS_PER_MARKET_LIMIT="20"

# App Branding
NEXT_PUBLIC_APP_NAME="Polymarket Sentiment Lens"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
